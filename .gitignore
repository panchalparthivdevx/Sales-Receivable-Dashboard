.env
node_modules/
dist/
build/

# Compliance Dashboard — confidential documents, runtime data and automatic backups
compliance_storage/
server/compliance/data/
server/compliance/backups/

# Secrets — login accounts and the live Zoho access token
server/users.json
server/.token_cache.json

# Runtime caches — rebuilt automatically from Zoho on every sync
server/sync_data/
# MSME other companies (Neddle …): their synced data and dashboard entries, like DevX's above
server/companies/
server/pocm_disk_cache/
server/pl_fy_cache/

# Uploaded documents (confidential)
server/vendor-uploads/
server/portal-uploads/
server/vpr-bill-uploads/
# Bill Collection & Booking: collected bills, its data (team, mappings, encrypted mailbox tokens)
server/bill-booking/files/
server/bill-booking/data/
# GSTR-2B Reco: Books documents synced from Zoho, uploaded GSTR-2B statements (originals), reconciliation results, audit trail
server/gstr2b/files/
server/gstr2b/data/
# 26AS Reconciliation: Zoho TDS postings, uploaded Form 26AS statements (originals), mappings, review decisions, audit trail
server/tds26as/data/
server/tds26as/files/
# Financial Reporting: imported statement versions, adjustments, decisions, management inputs
server/fin-reporting/data/
# Compliance Dashboard Vr.2.0: entities, tasks, audit trail and the encrypted evidence files (confidential, never in git)
server/compliance2/data/
server/compliance2/files/

# Company documents and data — stay on this PC, never in git (deployed data lives in Neon)
Client Agreements/
TDS Dashboard/
Compliance & Payroll/
Loan Module/
GST/
MSME/
/*.xlsx
# Source financial workbooks and presentations (trial balances, workings) — confidential
Financials & Presentations/
/*.pdf
Self Client Generated Code*.txt
server/*.json
server/fpa/*.json
