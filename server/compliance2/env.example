# Compliance Dashboard Vr.2.0 — settings it reads (NAMES ONLY — never put real values in this file or in git)
#
# Required for the LIVE space to accept documents: 64 hexadecimal characters (32 random bytes).
#   Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   Keep a copy apart from the backups: without it the stored evidence cannot be decrypted.
C2_FILE_KEY=

# Already set for the whole dashboard (signs logins; also signs this module's download links and the demo file key)
# JWT_SECRET=

# Optional: a ClamAV daemon for the malware scan (otherwise Microsoft Defender on the office PC; "unscanned" elsewhere)
# C2_CLAMD_HOST=
# C2_CLAMD_PORT=3310

# Optional: where the office PC keeps the module's data and encrypted files (defaults: server/compliance2/data and /files)
# C2_DATA_DIR=
# C2_FILES_DIR=

# OneDrive folders: the Microsoft 365 app registration made by your administrator (delegated permissions offline_access,
# Files.ReadWrite, User.Read). If these are not set, MAIL_MS_* and then BB_MS_* are used (one registration can serve all modules).
# C2_MS_TENANT_ID=
# C2_MS_CLIENT_ID=
# C2_MS_CLIENT_SECRET=
# Optional: the dashboard's public address for the Microsoft sign-in return (default: the address the browser used)
# C2_PUBLIC_URL=https://salesreceivables.devx.work

# Online (Vercel) the data is in Neon (DATABASE_URL, already set) and the files in the private Blob store (already connected).
