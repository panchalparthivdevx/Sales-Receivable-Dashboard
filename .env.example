# Zoho Books API
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token
ZOHO_ORG_ID=your_zoho_org_id
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_DOMAIN=https://www.zohoapis.in

# Neon PostgreSQL (required for Vercel deployment)
# Get this from your Neon project dashboard > Connection Details
DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Auth (required — the server will not start without JWT_SECRET; use a long random value)
PAYROLL_PASSWORD=change_me
# Vercel Cron only: a random string of 16+ characters
CRON_SECRET=change_me
JWT_SECRET=change-this-to-a-long-random-string

# Server
PORT=3002
NODE_ENV=development

# Vendor Registration — Public URL
# Set this to the public URL of your server (Cloudflare Tunnel, ngrok, Vercel, etc.)
# so that external vendors can access the registration form.
# Example (Cloudflare Tunnel): VENDOR_FORM_PUBLIC_URL=https://devx-vendor.your-tunnel.cfargotunnel.com
# Example (ngrok):             VENDOR_FORM_PUBLIC_URL=https://abc123.ngrok-free.app
# Example (Vercel):            VENDOR_FORM_PUBLIC_URL=https://your-project.vercel.app
# Leave blank to use the local URL (not accessible to external vendors)
VENDOR_FORM_PUBLIC_URL=

# Vercel (optional)
# Lock the CRM team's /crm-form: share it as /crm-form?key=<this value>
CRM_FORM_KEY=
# Company OneDrive/SharePoint copy of the "Client Agreements" folder (same layout); Vercel opens PDFs there
AGREEMENTS_BASE_URL=
